fn conf_enable_beattime {
    enable_beattime=yes
    conf_enable_app beattime
}

fn beattime_init {
    if (! ~ $#enable_beattime 0 ) {
        handler_body_main=beattime
        handlers_bar_left=()
        handlers_body_foot=()
       
    }
}

fn beattime {
    beat=`{/var/www/werc/apps/beattime/schizoclock}
    echo $beat
}
